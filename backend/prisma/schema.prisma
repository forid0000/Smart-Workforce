// Smart Workforce & Task Allocation System
// Prisma schema
//
// CP-1: Database is set to SQLite by default so the project runs out of the box
// even when PostgreSQL is not installed on the developer machine.
//
// To switch back to PostgreSQL (the production / proposal target):
//   1. Set DATABASE_PROVIDER=postgresql in backend/.env
//   2. Set DATABASE_URL to your PostgreSQL connection string
//   3. Run: npx prisma db push
//
// Note: SQLite does not support native enums, so role / availability / status /
// priority fields are typed as String. The backend enforces allowed values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Users (auth) ----------
model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  role       String   @default("EMPLOYEE") // ADMIN | EMPLOYEE
  employeeId Int?     @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
}

// ---------- Departments ----------
model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  employees Employee[]
}

// ---------- Employees ----------
model Employee {
  id               Int            @id @default(autoincrement())
  name             String
  email            String         @unique
  position         String
  capacity         Int            @default(8)
  availability     String      @default("AVAILABLE") // AVAILABLE | BUSY | UNAVAILABLE
  departmentId     Int
  department       Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  skills           EmployeeSkill[]
  assignments      TaskAssignment[]
  workLogs         WorkLog[]
  user             User?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([departmentId])
  @@index([availability])
}

// ---------- Skills ----------
model Skill {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  employees    EmployeeSkill[]
  tasks        TaskSkill[]
  createdAt    DateTime       @default(now())
}

// ---------- Employee ↔ Skill (M:N) ----------
model EmployeeSkill {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId     Int
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level       String @default("INTERMEDIATE") // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT

  @@unique([employeeId, skillId])
  @@index([skillId])
}

// ---------- Projects ----------
model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  status      String      @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

// ---------- Tasks ----------
model Task {
  id              Int            @id @default(autoincrement())
  title           String
  description     String?
  projectId       Int
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  priority        String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  estimatedHours  Int            @default(1)
  deadline        DateTime
  status          String     @default("PENDING") // PENDING | ASSIGNED | IN_PROGRESS | REVIEW | COMPLETED | OVERDUE | CANCELLED
  requiredSkills  TaskSkill[]
  assignments     TaskAssignment[]
  workLogs        WorkLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([deadline])
}

// ---------- Task ↔ Skill (M:N) ----------
model TaskSkill {
  id      Int   @id @default(autoincrement())
  taskId  Int
  task    Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skillId Int
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([taskId, skillId])
  @@index([skillId])
}

// ---------- Task ↔ Employee (assignment history) ----------
model TaskAssignment {
  id         Int       @id @default(autoincrement())
  taskId     Int
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  score      Float?
  note       String?

  @@index([taskId])
  @@index([employeeId])
}

// ---------- Work Log (employee submits hours worked) ----------
model WorkLog {
  id          Int       @id @default(autoincrement())
  taskId      Int
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actualHours Float
  note        String?
  loggedAt    DateTime  @default(now())

  @@index([taskId])
  @@index([employeeId])
}